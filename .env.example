# Copy to .env and fill in. `docker compose up` reads this automatically --
# but note docker-compose.yml only runs the frontend now (backend + inference
# are Modal-hosted by default, see DEPLOYMENT.md), so only the "frontend"
# section below actually affects it. The LA_* vars matter if you run
# backend/app.py yourself (natively, or as its own Modal deployment/secret --
# see modal_app/backend_server.py) rather than using the deployed one.
# Unset / left at the shown defaults, the backend behaves exactly as if
# this file didn't exist (LA_INFERENCE_BACKEND defaults to "local").

# Which InferenceEngine backend/app.py uses: "local" (CPU, locate-anything.cpp,
# needs the GGUF weights volume-mounted -- see README's "Get the model"),
# "triton" (self-hosted Triton Inference Server, e.g. on a DGX Spark), or
# "modal" (Modal-hosted GPU deployment, see DEPLOYMENT.md's "Deploying modal_app/model_server.py").
LA_INFERENCE_BACKEND=local

# --- LA_INFERENCE_BACKEND=triton ---
LA_TRITON_URL=localhost:8000
LA_TRITON_MODEL_NAME=locate_anything

# --- LA_INFERENCE_BACKEND=modal ---
# Printed by `modal deploy modal_app/model_server.py`.
LA_MODAL_URL=
# Value of the la-modal-shared-token Modal secret (LA_MODAL_SHARED_TOKEN).
LA_MODAL_TOKEN=
# NOTE: LA_MODAL_GPU (A10G/L40S/A100/H100/...) is NOT read here or by the
# backend -- it's a deploy-time-only choice read by modal_app/model_server.py
# itself when you run `modal deploy`, e.g. `LA_MODAL_GPU=L40S modal deploy
# modal_app/model_server.py`. See DEPLOYMENT.md's GPU type comparison.

# How many tiles of one image are sent to the engine concurrently (default 1
# = original one-at-a-time behavior). Only raise this for LA_INFERENCE_BACKEND
# triton/modal -- local mode fails fast at startup if this is >1, since
# la_capi.LocateAnythingEngine (a single loaded model instance) isn't safe
# for concurrent calls. See DEPLOYMENT.md's concurrency section for what this
# actually buys you against Modal.
LA_TILE_CONCURRENCY=1

# How many whole /detect requests run at once (default 1 = original
# one-at-a-time behavior) -- e.g. the frontend's "compare up to 5 prompts on
# the same image" feature, which used to run those 5 requests sequentially.
# Same triton/modal-only restriction as LA_TILE_CONCURRENCY, same reason.
LA_REQUEST_CONCURRENCY=1

# --- frontend ---
# Both are baked in at frontend *build* time (docker-compose.yml passes them
# as Dockerfile ARGs) -- changing either needs `docker compose up --build`,
# not just a container restart.

# The backend URL the frontend calls (frontend/src/api.ts, Vite env var).
# docker-compose.yml defaults this to the deployed Modal backend's URL if
# left unset here -- override to point at something else instead (a locally
# (natively) run backend, a docker-compose.triton.yml network hostname, or a
# different Modal deployment).
VITE_API_BASE_URL=

# Which scene (see frontend/public/scene-config/scenes.json for ids) loads by
# default. Empty/unset, or naming a scene that doesn't exist, falls back to
# the first entry in scenes.json. Unlike scenes.json itself (fetched at
# runtime, and bind-mounted by docker-compose.yml as a directory -- edit +
# refresh, no rebuild), this one IS baked in at build time same as
# VITE_API_BASE_URL above.
VITE_DEFAULT_SCENE_ID=
